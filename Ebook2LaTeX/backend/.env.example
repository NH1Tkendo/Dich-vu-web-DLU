# Application
APP_NAME=Ebook2LaTeX
APP_VERSION=0.1.0
DEBUG=True

# CORS Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ebook2latex
# 
# For SQLite (development):
DATABASE_URL=sqlite:///./ebook2latex.db

# File Upload
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=uploads
